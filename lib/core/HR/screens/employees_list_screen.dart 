  // ═══════════════════════════════════════════════════════════════
  // HELPER FUNCTIONS
  // ═══════════════════════════════════════════════════════════════

  Map<String, dynamic> _getStatusData(String status) {
    switch (status) {
      case 'working':
        return {
          'label': 'WORKING',
          'color': kSuccess,
          'icon': Icons.check_circle_rounded,
        };
      case 'late':
        return {
          'label': 'LATE',
          'color': kWarning,
          'icon': Icons.warning_rounded,
        };
      case 'field':
        return {
          'label': 'FIELD',
          'color': Colors.blue,
          'icon': Icons.location_on_rounded,
        };
      case 'break':
        return {
          'label': 'ON BREAK',
          'color': Colors.orange,
          'icon': Icons.free_breakfast_rounded,
        };
      case 'absent':
        return {
          'label': 'ABSENT',
          'color': kDanger,
          'icon': Icons.person_off_rounded,
        };
      case 'leave':
        return {
          'label': 'LEAVE',
          'color': Colors.purple,
          'icon': Icons.beach_access_rounded,
        };
      default:
        return {
          'label': 'UNKNOWN',
          'color': Colors.grey,
          'icon': Icons.help_rounded,
        };
    }
  }

  Color _getTypeColor(String type) {
    switch (type) {
      case 'Office':
        return kPrimary;
      case 'Field':
        return Colors.blue;
      case 'Sales':
        return Colors.teal;
      case 'Delivery':
        return Colors.orange;
      default:
        return Colors.grey;
    }
  }

  String _getInitials(String name) {
    final parts = name.split(' ');
    if (parts.length >= 2) {
      return '${parts[0][0]}${parts[1][0]}'.toUpperCase();
    }
    return name.substring(0, 2).toUpperCase();
  }

  double _getProgressValue(String workingHours) {
    // Assuming 8-hour workday
    try {
      final parts = workingHours.split('h ');
      final hours = int.parse(parts[0]);
      final minutes = int.parse(parts[1].replaceAll('m', ''));
      final totalMinutes = (hours * 60) + minutes;
      return totalMinutes / 480; // 8 hours = 480 minutes
    } catch (e) {
      return 0.0;
    }
  }
